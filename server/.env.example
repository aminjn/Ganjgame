# پیکربندی سرور بازی گنج — این فایل را به server/.env کپی کنید
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/ganj.sqlite
STATIC_DIR=../dist
# کلید امضای نشست‌ها (تصادفی و بلند). با تغییرش همه‌ی نشست‌ها باطل می‌شود
JWT_SECRET=change-me-to-a-long-random-string
# گذرواژه‌ی پنل ادمین (admin.html)
ADMIN_PASSWORD=change-me
# آدرس عمومی سایت (برای بازگشت درگاه پرداخت)
PUBLIC_URL=https://example.com
# پشت nginx = 1
TRUST_PROXY=1
# روی HTTPS = 1
COOKIE_SECURE=1
TICK_MS=250
# درگاه زرین‌پال؛ اگر خالی باشد شارژ «دستی» ثبت می‌شود و ادمین در پنل تأیید می‌کند
ZARINPAL_MERCHANT=
ZARINPAL_SANDBOX=0
